    "views": [
      {
        "id": "signals",
        "label": "Where the data lives",
        "focus": [
          "oracle-apps",
          "oracle-alloy",
          "oracle-exporters",
          "oracle-loki",
          "oracle-prom",
          "edge",
          "ec2-apps",
          "ec2-exporters",
          "ec2-promtail",
          "ec2-prom",
          "ec2-loki"
        ],
        "note": "Each server keeps its own Prometheus and Loki. Nothing is copied off the box."
      },
      {
        "id": "reading",
        "label": "How the board reads",
        "focus": [
          "oracle-grafana",
          "ec2-grafana",
          "ga",
          "betterstack",
          "board-api",
          "browser"
        ],
        "note": "Vercel Functions query every Grafana at once, then add Better Stack and Google Analytics. No token leaves the function."
      },
      {
        "id": "alerting",
        "label": "When a box dies",
        "focus": [
          "oracle-prom",
          "oracle-am",
          "ec2-prom",
          "ec2-am",
          "telegram",
          "betterstack"
        ],
        "note": "Alertmanager pages Telegram on its own. If a whole box dies, its alerts die with it, but Better Stack still sees its sites from outside."
      }
    ]
  },
